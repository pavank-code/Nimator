# Visual Explainer Generator - Environment Variables

# ===========================================
# LLM Configuration (at least one recommended)
# The system auto-detects available providers
# Priority: Groq > OpenRouter > Gemini > OpenAI
# ===========================================

# Groq (RECOMMENDED - Fast & Free)
# Get free API key: https://console.groq.com/
GROQ_API_KEY=

# OpenRouter (Many models available)
# Get API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google Gemini (Fast & Free tier)
# Get API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI (Paid)
# Get API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ===========================================
# LLM Provider Selection (optional)
# ===========================================
# Set to force a specific provider: auto, groq, openrouter, gemini, openai
# Default is 'auto' which picks first available key
LLM_PROVIDER=auto

# Custom model overrides (optional)
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct  
# GEMINI_MODEL=gemini-1.5-flash
# OPENAI_MODEL=gpt-4o-mini

# ===========================================
# Redis (default works with docker-compose)
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379

# Backend settings
API_HOST=0.0.0.0
API_PORT=8000

# Video settings
MAX_SCENES=6
RENDER_TIMEOUT=20
VIDEO_FPS=30
